{
  "name": "velocemotor",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "astro build",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "check": "astro check && tsc -p functions --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:keepalive": "wrangler deploy --config workers/keepalive/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "astro": "^7.4.13",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.168.0"
  }
}
