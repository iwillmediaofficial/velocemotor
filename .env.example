# Build-time / browser values (safe to expose). Copy to .env for local dev,
# and add the same variables in Cloudflare Pages → Settings → Environment variables.
PUBLIC_SITE_URL=https://velocemotor.com
PUBLIC_SUPABASE_URL=https://ezynivufmaeftqymvawu.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…)
PUBLIC_SUPABASE_KEY=sb_publishable_xxx
# Public base URL of the R2 media bucket (custom domain, e.g. https://media.velocemotor.com)
PUBLIC_MEDIA_URL=https://media.velocemotor.com
# Cloudflare Turnstile site key. 1x00000000000000000000AA is Cloudflare's always-pass test key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
