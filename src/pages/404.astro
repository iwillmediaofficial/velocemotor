---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section>
    <div class="container" style="text-align:center;padding:60px 0">
      <span class="eyebrow">404</span>
      <h1 style="margin:12px 0">Page not found</h1>
      <p class="muted">The page you're looking for doesn't exist or has moved.</p>
      <div class="ctas" style="justify-content:center;margin-top:24px"><a class="btn btn-primary" href="/">Go Home</a><a class="btn btn-outline" href="/products">Browse Products</a></div>
    </div>
  </section>
</Base>
